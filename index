        // Game State Variables
        let currentQuestionIndex = 0;
        let score = 0;
        let lives = 3;
        let combo = 0;
        let maxCombo = 0;
        let timer = null;
        let timeLeft = 15;
        let activePlayer = "";
        let userAnswers = [];
        let lifeline5050Used = false;
        let lifelineFreezeUsed = false;

        // Start Quiz Logic
        window.checkAndStartQuiz = function() {
            const nameInput = document.getElementById('player-name-input');
            const name = nameInput.value.trim();

            if (!name) {
                showToast("กรุณากรอกชื่อ-นามสกุล หรือชื่อเล่นก่อนเริ่มเกม", "error");
                nameInput.focus();
                return;
            }

            activePlayer = name;
            playSound('click');

            // Switch Screens
            document.getElementById('start-screen').classList.add('hidden');
            document.getElementById('quiz-screen').classList.remove('hidden');
            document.getElementById('active-player-tag').innerText = activePlayer;

            // Reset Game Stats
            currentQuestionIndex = 0;
            score = 0;
            lives = 3;
            combo = 0;
            maxCombo = 0;
            userAnswers = [];
            lifeline5050Used = false;
            lifelineFreezeUsed = false;

            updateLivesUI();
            loadQuestion();
        };

        function updateLivesUI() {
            const container = document.getElementById('lives-container');
            container.innerHTML = '';
            for (let i = 0; i < 3; i++) {
                const heart = document.createElement('i');
                if (i < lives) {
                    heart.className = "fa-solid fa-heart text-red-500 text-sm " + (lives === 1 ? "animate-heart-danger" : "");
                } else {
                    heart.className = "fa-solid fa-heart text-slate-300 text-sm";
                }
                container.appendChild(heart);
            }
        }

        function loadQuestion() {
            if (currentQuestionIndex >= questions.length) {
                endQuiz();
                return;
            }

            const q = questions[currentQuestionIndex];
            document.getElementById('question-counter').innerText = `ข้อ ${currentQuestionIndex + 1}/${questions.length}`;
            document.getElementById('question-category').innerText = q.category;
            document.getElementById('question-text').innerText = q.text;

            // Reset UI states
            const explanationBox = document.getElementById('explanation-box');
            explanationBox.classList.add('hidden');

            // Reset Lifeline buttons
            document.getElementById('lifeline-5050').disabled = lifeline5050Used;
            document.getElementById('lifeline-freeze').disabled = lifelineFreezeUsed;

            const optionsContainer = document.getElementById('options-container');
            optionsContainer.innerHTML = '';

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "option-btn w-full text-left p-4 rounded-2xl bg-amber-50/60 hover:bg-amber-100/80 border border-amber-200/80 font-semibold text-slate-700 text-sm md:text-base flex items-center justify-between group shadow-sm";
                btn.dataset.index = idx;
                btn.onclick = () => selectAnswer(idx);

                btn.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-amber-200/70 text-amber-900 font-bold text-xs flex items-center justify-center shrink-0 group-hover:bg-amber-500 group-hover:text-white transition">${String.fromCharCode(65 + idx)}</span>
                        <span>${opt}</span>
                    </div>
                    <i class="fa-solid fa-chevron-right text-amber-400 text-xs opacity-0 group-hover:opacity-100 transition"></i>
                `;
                optionsContainer.appendChild(btn);
            });

            startTimer();
        }

        function startTimer() {
            clearInterval(timer);
            timeLeft = 15;
            updateTimerUI();

            timer = setInterval(() => {
                timeLeft--;
                updateTimerUI();
                if (timeLeft <= 0) {
                    clearInterval(timer);
                    handleTimeout();
                }
            }, 1000);
        }

        function updateTimerUI() {
            const timerText = document.getElementById('timer-text');
            const timerBar = document.getElementById('timer-bar');
            timerText.innerText = `⏱️ ${timeLeft}s`;
            const pct = (timeLeft / 15) * 100;
            timerBar.style.width = `${pct}%`;
        }

        function handleTimeout() {
            playSound('wrong');
            lives--;
            updateLivesUI();
            combo = 0;
            updateComboUI();

            const q = questions[currentQuestionIndex];
            userAnswers.push({
                question: q.text,
                selected: "หมดเวลา",
                correct: q.options[q.correct],
                isCorrect: false
            });

            if (lives <= 0) {
                endQuiz();
                return;
            }

            lockOptionsAndShowExplanation(false, "หมดเวลา! คุณเสีย 1 พลังชีวิต");
        }

        window.selectAnswer = function(selectedIndex) {
            clearInterval(timer);
            const q = questions[currentQuestionIndex];
            const isCorrect = selectedIndex === q.correct;

            const optionsContainer = document.getElementById('options-container');
            const buttons = optionsContainer.getElementsByTagName('button');

            Array.from(buttons).forEach((btn, idx) => {
                btn.disabled = true;
                if (idx === q.correct) {
                    btn.className = "w-full text-left p-4 rounded-2xl bg-emerald-100 border-2 border-emerald-500 font-bold text-emerald-900 text-sm md:text-base flex items-center justify-between shadow-sm";
                    btn.innerHTML += `<i class="fa-solid fa-circle-check text-emerald-600 text-lg"></i>`;
                } else if (idx === selectedIndex && !isCorrect) {
                    btn.className = "w-full text-left p-4 rounded-2xl bg-red-100 border-2 border-red-500 font-bold text-red-900 text-sm md:text-base flex items-center justify-between shadow-sm animate-shake";
                    btn.innerHTML += `<i class="fa-solid fa-circle-xmark text-red-600 text-lg"></i>`;
                } else {
                    btn.className = "w-full text-left p-4 rounded-2xl bg-slate-50 border border-slate-200 text-slate-400 text-sm md:text-base opacity-50";
                }
            });

            userAnswers.push({
                question: q.text,
                selected: q.options[selectedIndex],
                correct: q.options[q.correct],
                isCorrect: isCorrect
            });

            if (isCorrect) {
                playSound('correct');
                combo++;
                if (combo > maxCombo) maxCombo = combo;

                let multiplier = 1;
                if (combo >= 5) multiplier = 3;
                else if (combo >= 3) multiplier = 2;
                else if (combo >= 2) multiplier = 1.5;

                const speedBonus = timeLeft * 5;
                const earned = Math.round((100 + speedBonus) * multiplier);
                score += earned;

                document.getElementById('current-score').innerText = score;
                updateComboUI();
                lockOptionsAndShowExplanation(true, `ถูกต้อง! ยอดเยี่ยมมาก ได้รับ +${earned} คะแนน (คอมโบ x${multiplier})`);
            } else {
                playSound('wrong');
                lives--;
                updateLivesUI();
                combo = 0;
                updateComboUI();

                if (lives <= 0) {
                    lockOptionsAndShowExplanation(false, "ตอบผิดและพลังชีวิตหมดลงแล้ว!");
                    setTimeout(() => endQuiz(), 1500);
                    return;
                }
                lockOptionsAndShowExplanation(false, `ยังไม่ถูกต้อง! เสีย 1 พลังชีวิต`);
            }
        };

        function updateComboUI() {
            const badge = document.getElementById('combo-badge');
            const text = document.getElementById('combo-multiplier-text');
            if (combo >= 2) {
                badge.classList.remove('hidden');
                let mult = combo >= 5 ? '3' : (combo >= 3 ? '2' : '1.5');
                text.innerText = `COMBO x${mult}! 🔥`;
            } else {
                badge.classList.add('hidden');
            }
        }

        function lockOptionsAndShowExplanation(isCorrect, message) {
            const expBox = document.getElementById('explanation-box');
            const expIcon = document.getElementById('explanation-icon');
            const expTitle = document.getElementById('explanation-title');
            const expText = document.getElementById('explanation-text');

            expBox.classList.remove('hidden');
            if (isCorrect) {
                expBox.className = "mt-5 p-4 rounded-2xl border bg-emerald-50 border-emerald-300 transition-all duration-300";
                expIcon.className = "w-8 h-8 rounded-full bg-emerald-500 flex items-center justify-center shrink-0 mt-0.5 text-white font-bold text-sm shadow-sm";
                expIcon.innerHTML = `<i class="fa-solid fa-check"></i>`;
                expTitle.className = "font-bold text-sm md:text-base text-emerald-900";
                expTitle.innerText = message;
            } else {
                expBox.className = "mt-5 p-4 rounded-2xl border bg-red-50 border-red-300 transition-all duration-300";
                expIcon.className = "w-8 h-8 rounded-full bg-red-500 flex items-center justify-center shrink-0 mt-0.5 text-white font-bold text-sm shadow-sm";
                expIcon.innerHTML = `<i class="fa-solid fa-xmark"></i>`;
                expTitle.className = "font-bold text-sm md:text-base text-red-900";
                expTitle.innerText = message;
            }

            expText.innerText = questions[currentQuestionIndex].explanation;
        }

        window.nextQuestion = function() {
            playSound('click');
            currentQuestionIndex++;
            loadQuestion();
        };

        // Lifelines
        window.useLifeline5050 = function() {
            if (lifeline5050Used) return;
            lifeline5050Used = true;
            document.getElementById('lifeline-5050').disabled = true;

            const q = questions[currentQuestionIndex];
            const optionsContainer = document.getElementById('options-container');
            const buttons = optionsContainer.getElementsByTagName('button');

            let removedCount = 0;
            Array.from(buttons).forEach((btn, idx) => {
                if (idx !== q.correct && removedCount < 2) {
                    btn.disabled = true;
                    btn.className = "w-full text-left p-4 rounded-2xl bg-slate-100 border border-slate-200 text-slate-300 opacity-30 cursor-not-allowed";
                    removedCount++;
                }
            });
            showToast("ใช้ตัวช่วย 50/50 ตัดตัวเลือกผิดออก 2 ข้อแล้ว");
        };

        window.useLifelineFreeze = function() {
            if (lifelineFreezeUsed) return;
            lifelineFreezeUsed = true;
            document.getElementById('lifeline-freeze').disabled = true;

            timeLeft += 10;
            updateTimerUI();
            showToast("แช่แข็งเวลาสำเร็จ! เพิ่มเวลา +10 วินาที");
        };

        function endQuiz() {
            clearInterval(timer);
            document.getElementById('quiz-screen').classList.add('hidden');
            document.getElementById('result-screen').classList.remove('hidden');

            const correctCount = userAnswers.filter(a => a.isCorrect).length;
            document.getElementById('final-score').innerText = score;
            document.getElementById('final-correct').innerText = `${correctCount}/12`;
            document.getElementById('final-combo').innerText = `x${maxCombo}`;
            document.getElementById('final-player-name').value = activePlayer;

            // Rank Badge Assignment
            const rankTitle = document.getElementById('rank-title');
            const rankMsg = document.getElementById('rank-message');
            const badgeBg = document.getElementById('rank-badge-bg');
            const rankIcon = document.getElementById('rank-icon');

            if (correctCount >= 10) {
                rankTitle.innerText = "🏆 ปรมาจารย์เพลงพื้นบ้านเอกอุ";
                rankMsg.innerText = "ยอดเยี่ยมที่สุด! คุณมีความเข้าใจในวรรณกรรมท้องถิ่นเรื่องเพลงพื้นบ้านอย่างลึกซึ้งสมกับเป็นนักปราชญ์ตัวจริง";
                badgeBg.className = "w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-tr from-amber-500 to-yellow-400 flex items-center justify-center mx-auto shadow-lg animate-float";
                rankIcon.className = "fa-solid fa-crown text-white text-4xl md:text-5xl drop-shadow-md";
            } else if (correctCount >= 7) {
                rankTitle.innerText = "🥈 นักปราชญ์เพลงพื้นบ้านระดับดี";
                rankMsg.innerText = "ทำได้ดีมาก! คุณมีความรู้ความเข้าใจในเพลงพื้นบ้านทั้ง 4 ภาคและคุณค่าทางสังคมเป็นอย่างดี";
                badgeBg.className = "w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-tr from-slate-400 to-slate-200 flex items-center justify-center mx-auto shadow-lg animate-float";
                rankIcon.className = "fa-solid fa-award text-white text-4xl md:text-5xl drop-shadow-md";
            } else {
                rankTitle.innerText = "🥉 นักศึกษาผู้พยายามเรียนรู้";
                rankMsg.innerText = "ผ่านการทดสอบแล้ว! ลองทบทวน 'คลังความรู้' เพิ่มเติมอีกนิดเพื่อความแม่นยำยิ่งขึ้นนะจ๊ะ";
                badgeBg.className = "w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-tr from-amber-700 to-amber-600 flex items-center justify-center mx-auto shadow-lg animate-float";
                rankIcon.className = "fa-solid fa-medal text-white text-4xl md:text-5xl drop-shadow-md";
            }

            try {
                confetti({
                    particleCount: 120,
                    spread: 70,
                    origin: { y: 0.6 }
                });
            } catch(e) {}
        }

        window.toggleAnswerReview = function() {
            const container = document.getElementById('answers-review-container');
            if (container.classList.contains('hidden')) {
                container.classList.remove('hidden');
                container.innerHTML = '';
                userAnswers.forEach((ans, idx) => {
                    const item = document.createElement('div');
                    item.className = `p-3 rounded-xl border text-xs ${ans.isCorrect ? 'bg-emerald-50/70 border-emerald-200 text-emerald-900' : 'bg-red-50/70 border-red-200 text-red-900'}`;
                    item.innerHTML = `
                        <span class="font-bold block mb-1">ข้อที่ ${idx + 1}: ${escapeHtml(ans.question)}</span>
                        <div><strong>ตอบ:</strong> ${escapeHtml(ans.selected)} ${ans.isCorrect ? '✅' : '❌ (เฉลย: ' + escapeHtml(ans.correct) + ')'}</div>
                    `;
                    container.appendChild(item);
                });
            } else {
                container.classList.add('hidden');
            }
        };

        // Modals Control
        window.openLeaderboardModal = function() {
            playSound('click');
            document.getElementById('leaderboard-modal').classList.remove('hidden');
        };

        window.closeLeaderboardModal = function() {
            playSound('click');
            document.getElementById('leaderboard-modal').classList.add('hidden');
        };

        window.openKnowledgeModal = function() {
            playSound('click');
            document.getElementById('knowledge-modal').classList.remove('hidden');
        };

        window.closeKnowledgeModal = function() {
            playSound('click');
            document.getElementById('knowledge-modal').classList.add('hidden');
        };
    </script>
</body>
</html>
