    <!-- FIREBASE MODULE & GAME SCRIPT -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, onSnapshot } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Global environment bindings
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'folk-song-scholar-app';
        let db = null;
        let auth = null;
        let currentUser = null;

        // Local Storage Fallback for GitHub Pages Standalone Deployment
        function getLocalLeaderboard() {
            try {
                return JSON.parse(localStorage.getItem('folk_song_leaderboard') || '[]');
            } catch(e) { return []; }
        }

        function saveLocalLeaderboard(entry) {
            try {
                const list = getLocalLeaderboard();
                list.push(entry);
                list.sort((a, b) => b.score - a.score);
                localStorage.setItem('folk_song_leaderboard', JSON.stringify(list));
                return list;
            } catch(e) { return []; }
        }

        // Try initializing Firebase
        try {
            if (typeof __firebase_config !== 'undefined' && __firebase_config) {
                const firebaseConfig = JSON.parse(__firebase_config);
                const app = initializeApp(firebaseConfig);
                db = getFirestore(app);
                auth = getAuth(app);

                const initAuth = async () => {
                    try {
                        if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                            const cred = await signInWithCustomToken(auth, __initial_auth_token);
                            currentUser = cred.user;
                        } else {
                            const cred = await signInAnonymously(auth);
                            currentUser = cred.user;
                        }
                        setupLeaderboardListener();
                    } catch (e) {
                        console.warn("Auth initialization error:", e);
                        renderLeaderboardUI(getLocalLeaderboard());
                    }
                };
                initAuth();
            } else {
                // Fallback for direct GitHub Pages launch without cloud variables
                renderLeaderboardUI(getLocalLeaderboard());
            }
        } catch (err) {
            console.warn("Firebase standard fallback active:", err);
            renderLeaderboardUI(getLocalLeaderboard());
        }

        // Setup real-time leaderboard listener
        function setupLeaderboardListener() {
            if (!db) {
                renderLeaderboardUI(getLocalLeaderboard());
                return;
            }
            const leaderboardCol = collection(db, 'artifacts', appId, 'public', 'data', 'leaderboard');
            
            onSnapshot(leaderboardCol, (snapshot) => {
                const items = [];
                snapshot.forEach(doc => {
                    items.push({ id: doc.id, ...doc.data() });
                });

                items.sort((a, b) => b.score - a.score);
                renderLeaderboardUI(items);
            }, (error) => {
                console.error("Leaderboard snapshot error:", error);
                renderLeaderboardUI(getLocalLeaderboard());
            });
        }

        // Render Leaderboard Items
        function renderLeaderboardUI(items) {
            const container = document.getElementById('leaderboard-list');
            const countText = document.getElementById('leaderboard-count-text');
            if (!container) return;

            countText.innerText = `ผู้เข้าแข่งขันทั้งหมด: ${items.length} คน`;

            if (items.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-8 text-slate-400 space-y-2">
                        <i class="fa-solid fa-award text-3xl text-slate-300"></i>
                        <p class="text-xs font-semibold">ยังไม่มีข้อมูลในตารางคะแนน ร่วมบันทึกคะแนนเป็นคนแรก!</p>
                    </div>
                `;
                return;
            }

            container.innerHTML = '';
            items.forEach((item, index) => {
                const isTop3 = index < 3;
                let rankBadge = `<span class="w-7 h-7 rounded-full bg-slate-100 text-slate-700 font-bold text-xs flex items-center justify-center shrink-0 border border-slate-200">${index + 1}</span>`;

                if (index === 0) rankBadge = `<span class="w-7 h-7 rounded-full bg-amber-400 text-slate-900 font-extrabold text-xs flex items-center justify-center shrink-0 shadow-sm">🥇</span>`;
                if (index === 1) rankBadge = `<span class="w-7 h-7 rounded-full bg-slate-300 text-slate-900 font-extrabold text-xs flex items-center justify-center shrink-0 shadow-sm">🥈</span>`;
                if (index === 2) rankBadge = `<span class="w-7 h-7 rounded-full bg-amber-600 text-white font-extrabold text-xs flex items-center justify-center shrink-0 shadow-sm">🥉</span>`;

                const card = document.createElement('div');
                card.className = `p-3.5 rounded-2xl border ${isTop3 ? 'bg-gradient-to-r from-amber-50/70 to-orange-50/70 border-amber-300 shadow-sm' : 'bg-white border-slate-200'} space-y-2 transition`;

                card.innerHTML = `
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex items-center gap-2.5">
                            ${rankBadge}
                            <div>
                                <h4 class="font-extrabold text-slate-800 text-sm leading-tight">${escapeHtml(item.playerName || 'ผู้เล่น')}</h4>
                                <span class="text-[10px] text-slate-400">${item.timestamp ? new Date(item.timestamp).toLocaleTimeString('th-TH', {hour: '2-digit', minute:'2-digit'}) : 'เมื่อครู่'}</span>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-base font-black text-amber-700 font-prompt">${item.score}</span>
                            <span class="text-[10px] text-slate-500 font-bold block">ตอบถูก ${item.correctCount || 0}/12</span>
                        </div>
                    </div>
                    ${item.reflection ? `
                        <div class="bg-white/80 p-2.5 rounded-xl border border-amber-200/60 text-xs text-slate-600">
                            <span class="font-bold text-amber-900 block text-[11px] mb-0.5">💬 สรุปสิ่งที่เรียนรู้:</span>
                            "${escapeHtml(item.reflection)}"
                        </div>
                    ` : ''}
                `;
                container.appendChild(card);
            });
        }

        function escapeHtml(text) {
            if (!text) return '';
            return text.replace(/&/g, "&amp;")
                       .replace(/</g, "&lt;")
                       .replace(/>/g, "&gt;")
                       .replace(/"/g, "&quot;")
                       .replace(/'/g, "&#039;");
        }

        // Global function to submit score
        window.submitScoreToFirebase = async function() {
            const finalNameInput = document.getElementById('final-player-name');
            const reflectionInput = document.getElementById('reflection-input');
            const submitBtn = document.getElementById('submit-score-btn');

            const name = finalNameInput.value.trim();
            const reflection = reflectionInput.value.trim();

            if (!name) {
                showToast("กรุณากรอกชื่อก่อนส่งคะแนน", "error");
                finalNameInput.focus();
                return;
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> <span>กำลังส่งข้อมูล...</span>`;

            const entryData = {
                playerName: name,
                score: window.score || 0,
                correctCount: window.userAnswers ? window.userAnswers.filter(a => a.isCorrect).length : 0,
                maxCombo: window.maxCombo || 1,
                reflection: reflection,
                timestamp: Date.now()
            };

            try {
                if (db) {
                    const leaderboardCol = collection(db, 'artifacts', appId, 'public', 'data', 'leaderboard');
                    await addDoc(leaderboardCol, entryData);
                    showToast("บันทึกคะแนนและสรุปความรู้เรียบร้อยแล้ว!", "success");
                } else {
                    const updatedList = saveLocalLeaderboard(entryData);
                    renderLeaderboardUI(updatedList);
                    showToast("บันทึกคะแนนและสรุปความรู้เรียบร้อยแล้ว", "success");
                }

                submitBtn.className = "w-full py-3 rounded-xl bg-slate-300 text-slate-600 font-bold text-sm cursor-not-allowed";
                submitBtn.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>ส่งข้อมูลแล้ว</span>`;
                
                setTimeout(() => {
                    window.openLeaderboardModal();
                }, 800);
            } catch (err) {
                console.error("Submit error:", err);
                const updatedList = saveLocalLeaderboard(entryData);
                renderLeaderboardUI(updatedList);
                showToast("บันทึกคะแนนลงในเครื่องเรียบร้อยแล้ว", "success");
                submitBtn.className = "w-full py-3 rounded-xl bg-slate-300 text-slate-600 font-bold text-sm cursor-not-allowed";
                submitBtn.innerHTML = `<i class="fa-solid fa-circle-check"></i> <span>ส่งข้อมูลแล้ว</span>`;
            }
        };

        // Toast notification helper
        function showToast(message, type = 'success') {
            const toast = document.getElementById('toast');
            const toastMsg = document.getElementById('toast-message');
            const toastIcon = document.getElementById('toast-icon');

            toastMsg.innerText = message;
            if (type === 'error') {
                toastIcon.className = "fa-solid fa-triangle-exclamation text-red-400 text-xl";
            } else {
                toastIcon.className = "fa-solid fa-circle-check text-amber-400 text-xl";
            }

            toast.classList.remove('translate-y-[-100px]', 'opacity-0');
            toast.classList.add('translate-y-0', 'opacity-100');

            setTimeout(() => {
                toast.classList.remove('translate-y-0', 'opacity-100');
                toast.classList.add('translate-y-[-100px]', 'opacity-0');
            }, 3000);
        }

        // Sound Synthesis (Web Audio API)
        let soundEnabled = true;
        window.toggleSound = function() {
            soundEnabled = !soundEnabled;
            const icon = document.getElementById('sound-icon');
            if (soundEnabled) {
                icon.className = "fa-solid fa-volume-high text-lg";
                showToast("เปิดเสียงเอฟเฟกต์แล้ว");
            } else {
                icon.className = "fa-solid fa-volume-xmark text-lg";
                showToast("ปิดเสียงเอฟเฟกต์แล้ว");
            }
        };

        function playSound(type) {
            if (!soundEnabled) return;
            try {
                const ctx = new (window.AudioContext || window.webkitAudioContext)();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (type === 'correct') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(440, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.15);
                    gain.gain.setValueAtTime(0.2, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.3);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.3);
                } else if (type === 'wrong') {
                    osc.type = 'sawtooth';
                    osc.frequency.setValueAtTime(180, ctx.currentTime);
                    osc.frequency.linearRampToValueAtTime(110, ctx.currentTime + 0.2);
                    gain.gain.setValueAtTime(0.25, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.25);
                } else if (type === 'click') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(600, ctx.currentTime);
                    gain.gain.setValueAtTime(0.05, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.05);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.05);
                }
            } catch(e) {}
        }

        // Quiz Questions Data (12 Curriculum Questions)
        const questions = [
            {
                category: "หมวดที่ 1: ความหมายและที่มา",
                text: "ข้อใดให้ความหมายของ 'เพลงพื้นบ้าน' ได้ถูกต้องที่สุดตามหลักวรรณกรรมท้องถิ่น?",
                options: [
                    "บทร้อยกรองท้องถิ่นที่แต่งขึ้นโดยกวีราชสำนักเพื่อใช้ขับร้องในพระราชพิธี",
                    "บทร้อยกรองท้องถิ่นที่สืบทอดต่อกันมา ใช้ร้องเพื่อความบันเทิง ถ้อยคำเรียบง่าย ไม่มีเครื่องดนตรีใหญ่",
                    "บทเพลงสากลที่นำมาแปลเนื้อร้องเป็นภาษาถิ่นเพื่อความทันสมัย",
                    "บทสวดทางศาสนาที่พระสงฆ์ใช้เทศนาโปรดญาติโยมในวัด"
                ],
                correct: 1,
                explanation: "เพลงพื้นบ้านคือบทร้อยกรองท้องถิ่นที่จดจำสืบทอดกันมา (มุขปาฐะ) ใช้ร้องเพื่อความบันเทิง ใช้ถ้อยคำเรียบง่าย สัมผัสคล้องจอง และไม่นิยมใช้เครื่องดนตรีใหญ่"
            },
            {
                category: "หมวดที่ 1: ความหมายและที่มา",
                text: "ลักษณะสำคัญในการแสดงเพลงพื้นบ้านข้อใดที่บ่งบอกว่าเป็น 'การละเล่น' ไม่ใช่การแสดงมืออาชีพ?",
                options: [
                    "ต้องมีการจ้างวานนักแสดงและขายบัตรเข้าชมทุกครั้ง",
                    "ไม่มีการจ้างวาน สมาชิกในที่ชุมนุมผลัดกันร้องรำตามความสมัครใจ",
                    "ผู้แสดงต้องผ่านการฝึกอบรมจากกรมศิลปากรเท่านั้น",
                    "ต้องจัดแสดงบนเวทีโรงละครขนาดใหญ่ในเมืองหลวง"
